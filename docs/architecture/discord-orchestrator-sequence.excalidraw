    },
    {
      "id": "e59",
      "type": "text",
      "x": 89,
      "y": 599,
      "width": 1622,
      "height": 91,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0059",
      "roundness": null,
      "seed": 1059,
      "version": 1,
      "versionNonce": 9059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Primary user in exact thread → user/echo/route check → durable ingress checkpoint before feedback/RPC.\nExplicit multipart only: bounded ordered assembly, 30-minute expiry + tombstone cleanup; ordinary messages never join.\nImages: approved Discord CDN/type/size → download into pending inbox; failure is durably consumed + ⚠️.\nNakode atomically validates READY, claims ledger + stable client turn → 🔄 → continue same session; provider acknowledgement clears inbox.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Primary user in exact thread → user/echo/route check → durable ingress checkpoint before feedback/RPC.\nExplicit multipart only: bounded ordered assembly, 30-minute expiry + tombstone cleanup; ordinary messages never join.\nImages: approved Discord CDN/type/size → download into pending inbox; failure is durably consumed + ⚠️.\nNakode atomically validates READY, claims ledger + stable client turn → 🔄 → continue same session; provider acknowledgement clears inbox.",
      "autoResize": false,
      "lineHeight": 1.25
    },
