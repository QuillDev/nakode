      "seed": 1065,
      "version": 1,
      "versionNonce": 9065,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dashboard close → archive; reopen → unarchive/no-op.\nFresh start archives before IPC; shutdown archive barrier precedes teardown under a hard deadline.\nRestart restores the durable mapping.\n404 clears binding; later reconciliation recreates only while lifecycle is open.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Dashboard close → archive; reopen → unarchive/no-op.\nFresh start archives before IPC; shutdown archive barrier precedes teardown under a hard deadline.\nRestart restores the durable mapping.\n404 clears binding; later reconciliation recreates only while lifecycle is open.",
      "autoResize": false,
      "lineHeight": 1.25
