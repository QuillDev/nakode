      "versionNonce": 9056,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Runtime publishes user-visible live text → adapter edits/recreates one 🟡 message. Completion: sanitize/hash/count → PREPARE → deterministic nonce parts in order →\nadvance monotonic progress + latest message ID → completion reaction → FINALIZE cursor. Retry recovers nonces; old cursors page to a private spool.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Runtime publishes user-visible live text → adapter edits/recreates one 🟡 message. Completion: sanitize/hash/count → PREPARE → deterministic nonce parts in order →\nadvance monotonic progress + latest message ID → completion reaction → FINALIZE cursor. Retry recovers nonces; old cursors page to a private spool.",
      "autoResize": false,
      "lineHeight": 1.25
