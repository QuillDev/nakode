    },
    {
      "id": "e65",
      "type": "text",
      "x": 89,
      "y": 959,
      "width": 972,
      "height": 71,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0065",
