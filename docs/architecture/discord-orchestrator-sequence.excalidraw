      "containerId": null,
      "originalText": "3B · Inbound while BUSY / saturated",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "e62",
      "type": "text",
      "x": 89,
      "y": 784,
      "width": 1622,
      "height": 71,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0062",
      "roundness": null,
      "seed": 1062,
      "version": 1,
      "versionNonce": 9062,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Same authorization + ingress checkpoint → overlap/saturation is durably forced-busy and gets immediate ❌ → replay claims Nakode ledger with `consume_as_busy` → terminal tombstone/removal. A normal readiness race\nalso returns BUSY. No queue/steer/later prompt; duplicate gateway events are local tombstones or Nakode DUPLICATE no-ops.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Same authorization + ingress checkpoint → overlap/saturation is durably forced-busy and gets immediate ❌ → replay claims Nakode ledger with `consume_as_busy` → terminal tombstone/removal. A normal readiness race\nalso returns BUSY. No queue/steer/later prompt; duplicate gateway events are local tombstones or Nakode DUPLICATE no-ops.",
      "autoResize": false,
      "lineHeight": 1.25
    },
