      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "FStack sends Chat or Agent bridge intent → Nakode persists stable logical mapping (thread may be absent) → adapter lazily creates under the correct parent and atomically binds the thread snowflake. Restart\nrestores this row; titles are never identity.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "FStack sends Chat or Agent bridge intent → Nakode persists stable logical mapping (thread may be absent) → adapter lazily creates under the correct parent and atomically binds the thread snowflake. Restart\nrestores this row; titles are never identity.",
      "autoResize": false,
      "lineHeight": 1.25
    },
